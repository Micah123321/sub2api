{
  "name": "sub2api-agent-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Independent agent ledger plugin for sub2api",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev:server": "tsc -p tsconfig.server.json && node --watch dist/server/main.js",
    "dev:web": "vite --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config vite.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/server/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx tooling/migrate.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint apps tooling spec eslint.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/static": "^8.2.0",
    "@lucide/vue": "^1.26.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "argon2": "^0.43.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/testing": "^11.0.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "pinia": "^3.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.8"
  }
}
