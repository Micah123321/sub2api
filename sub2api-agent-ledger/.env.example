NODE_ENV=development
PORT=4173
PLUGIN_DATA_DIR=./data
SESSION_SECRET=replace-with-at-least-32-random-characters
PLUGIN_MASTER_KEY=replace-with-32-byte-base64-key
MAIN_SERVICE_BASE_URL=http://localhost:3000
MAIN_SERVICE_ADMIN_API_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
# 生产环境必须显式设置强密码；开发未设置时才使用临时口令
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# 逗号分隔的前端源白名单（credentials 模式不可用 *）
CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174
