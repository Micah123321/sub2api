# =============================================================================
# sub2api Agent Ledger — container env
# =============================================================================
# cp deploy/agent-ledger/.env.example deploy/agent-ledger/.env
# chmod 600 deploy/agent-ledger/.env
# =============================================================================

# Host bind
BIND_HOST=0.0.0.0
AGENT_LEDGER_PORT=4173
AGENT_LEDGER_CONTAINER_NAME=sub2api-agent-ledger
AGENT_LEDGER_IMAGE=sub2api-agent-ledger:local
AGENT_LEDGER_VOLUME_NAME=sub2api_agent_ledger_data
NODE_IMAGE=node:22-bookworm-slim
NODE_ENV=production
# Direct HTTP deployment: false. Set true when the public endpoint is HTTPS.
SESSION_COOKIE_SECURE=false

# Required secrets (generate strong random values)
# SESSION_SECRET: >= 16 chars
SESSION_SECRET=replace-with-at-least-32-random-characters
# PLUGIN_MASTER_KEY: prefer 32-byte base64, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLUGIN_MASTER_KEY=replace-with-32-byte-base64-key

# Bootstrap admin (production requires explicit password)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Main service (read-only calls authenticated by an admin login)
# Docker Desktop / Compose with host-gateway；保留这个 HTTP 地址时需把下一项改为 true:
MAIN_SERVICE_BASE_URL=http://host.docker.internal:8080
# 远程主机使用 HTTP 时必须显式设为 true；管理员密码将以明文通过网络传输
MAIN_SERVICE_ALLOW_INSECURE_HTTP=false
# 仅在 SQLite 尚未配置时导入；启用 TOTP/强制 Turnstile 时请改用兼容的管理员登录策略
MAIN_SERVICE_ADMIN_EMAIL=
MAIN_SERVICE_ADMIN_PASSWORD=

# Browser origins allowed with credentials (comma-separated)
# Same-origin SPA on :4173 typically:
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
